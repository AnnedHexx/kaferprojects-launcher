{
  "name": "kaferprojects-launcher",
  "productName": "KaferProjects Launcher",
  "version": "1.0.2",
  "description": "Launcher de Minecraft Bedrock con instancias de la red KaferProjects.",
  "author": "KaferProjects",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop": "next build && electron .",
    "desktop:installer": "next build && electron . --installer",
    "desktop:reinstall": "electron . --installer",
    "dist": "next build && electron-builder --win nsis"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "postcss": "^8.5",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3"
  },
  "build": {
    "appId": "net.kaferprojects.launcher",
    "productName": "KaferProjects Launcher",
    "asar": false,
    "compression": "maximum",
    "electronLanguages": ["es", "en-US", "en-GB"],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "node_modules/@xhayper/**/*",
      "node_modules/@discordjs/**/*",
      "node_modules/@vladfrangu/**/*",
      "node_modules/discord-api-types/**/*",
      "node_modules/@sapphire/**/*",
      "node_modules/magic-bytes.js/**/*",
      "node_modules/tslib/**/*",
      "!node_modules/@xhayper/discord-rpc/{test,src}/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/assets/icon.png",
        "to": "resources/app/electron/assets/icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KaferProjects-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KaferProjects Launcher",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "1034",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "KaferProjects Launcher ${version}",
      "differentialPackage": false
    }
  }
}
